# Copy to /opt/homelab/.env on the server and fill in. NEVER commit .env.

# Base domain. Services are published as <service>.<DOMAIN>:
#   app.<DOMAIN>  status.<DOMAIN>  grafana.<DOMAIN>  vpn.<DOMAIN>  traefik.<DOMAIN>
# No domain? Use sslip.io with your server IP written with dashes: 203-0-113-10.sslip.io
DOMAIN=example.com

# Let's Encrypt account email (expiry warnings go here).
ACME_EMAIL=you@example.com

# Let's Encrypt production endpoint. While experimenting, switch to staging to
# avoid rate limits (browsers will show an untrusted certificate):
#   ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

TRAEFIK_LOG_LEVEL=INFO

# Updated automatically by scripts/deploy.sh on every deploy.
APP_IMAGE=ghcr.io/your-github-user/homelab-app:latest

# WireGuard: public IP or hostname that VPN clients connect to.
WG_HOST=203.0.113.10
# bcrypt hash of the wg-easy web UI password. Generate it with:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'YourPassword'
# Keep the SINGLE quotes: the hash contains '$' characters that would
# otherwise be treated as variables.
WG_PASSWORD_HASH='$2a$12$replace.me.with.a.real.bcrypt.hash.generated.by.wgpw.'

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
